{
    "profiles": [
        {
            "name": "Default profile",
            "selected": true,
            "virtual_hid_keyboard": { "keyboard_type_v2": "ansi" },
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Caps Lock: Escape when tapped, Option (AeroSpace key) when held",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "caps_lock",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [{ "key_code": "left_option" }],
                                "to_if_alone": [{ "key_code": "escape" }]
                            }
                        ]
                    },
                    {
                        "description": "Option+Space: Spotlight (Cmd+Space), like i3 $mod+space launcher",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "spacebar",
                                    "modifiers": { "mandatory": ["option"] }
                                },
                                "to": [{ "key_code": "spacebar", "modifiers": ["left_command"] }]
                            }
                        ]
                    }
                ]
            }
        }
    ]
}
