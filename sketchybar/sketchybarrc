#!/bin/bash
# SketchyBar — https://felixkratz.github.io/SketchyBar/
# Left: AeroSpace workspaces, focused app. Right: clock, battery, volume.

PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/colors.sh"

# Rounded, translucent bar at the top edge.
# On the notched built-in display it fills the menu-bar strip (33pt), so the notch sits inside the bar
# instead of cutting through it. No border line, so nothing gets visibly clipped by the notch.
# topmost=window: sit at the very top regardless of how macOS reports menu bar auto-hide (macOS 26).
bar=(
  position=top
  topmost=window
  height=32
  notch_display_height=33
  y_offset=0
  margin=8
  corner_radius=10
  color="$BAR_COLOR"
  blur_radius=30
  border_width=0
  shadow=off
  padding_left=8
  padding_right=8
)
sketchybar --bar "${bar[@]}"

default=(
  icon.font="JetBrainsMono Nerd Font:Bold:15.0"
  label.font="JetBrainsMono Nerd Font:Bold:13.0"
  icon.color="$TEXT"
  label.color="$TEXT"
  padding_left=4
  padding_right=4
  icon.padding_left=4
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=4
)
sketchybar --default "${default[@]}"

##### AeroSpace workspaces #####
sketchybar --add event aerospace_workspace_change

for sid in $(aerospace list-workspaces --all); do
  sketchybar --add item "space.$sid" left \
    --subscribe "space.$sid" aerospace_workspace_change \
    --set "space.$sid" \
      icon.drawing=off \
      label="$sid" \
      label.padding_left=8 \
      label.padding_right=8 \
      padding_left=2 \
      padding_right=2 \
      background.color="$WHITE" \
      background.corner_radius=5 \
      background.height=22 \
      background.drawing=off \
      click_script="aerospace workspace $sid" \
      script="$PLUGIN_DIR/aerospace.sh $sid"
done

# Clicks open the real macOS menus via helpers/bin/menubar (Accessibility; see helpers/menubar.swift).
MENUBAR="$CONFIG_DIR/helpers/bin/menubar"

##### Focused app: click for its menus (File, Edit, …) #####
sketchybar --add item front_app left \
  --set front_app icon.drawing=off padding_left=12 label.color="$TEXT" \
    script="$PLUGIN_DIR/front_app.sh" \
    click_script="$PLUGIN_DIR/app_menus.sh" \
    popup.horizontal=on \
    popup.align=left \
    popup.height=28 \
    popup.background.color="$BAR_COLOR" \
    popup.background.corner_radius=8 \
    popup.blur_radius=30 \
  --subscribe front_app front_app_switched

##### Right side: click opens the matching macOS menu #####
sketchybar --add item clock right \
  --set clock update_freq=10 icon= script="$PLUGIN_DIR/clock.sh" \
    click_script="$MENUBAR press-extra com.apple.controlcenter menuextra.clock" \
  --add item battery right \
  --set battery update_freq=120 script="$PLUGIN_DIR/battery.sh" \
    click_script="$MENUBAR press-extra com.apple.controlcenter menuextra.battery" \
  --subscribe battery system_woke power_source_change \
  --add item volume right \
  --set volume script="$PLUGIN_DIR/volume.sh" \
    click_script="$MENUBAR press-extra com.apple.controlcenter menuextra.controlcenter" \
  --subscribe volume volume_change mouse.scrolled \
  --add item wifi right \
  --set wifi label.drawing=off update_freq=30 script="$PLUGIN_DIR/wifi.sh" \
    click_script="$MENUBAR press-extra com.apple.controlcenter menuextra.wifi" \
  --subscribe wifi wifi_change system_woke

##### Tray: background apps, glyph shown while running, click opens the app's own menu #####
# name | glyph (Nerd Font) | app bundle id | bundle id owning the menu bar icon | pgrep -f pattern (is it running?)
# Items further down the list appear further left in the bar.
TRAY=(
  "1password|󰌆|com.1password.1password|com.1password.1password|1Password.app/Contents/MacOS/1Password( |$)"
  "drive|󰊶|com.google.drivefs|com.google.drivefs|Google Drive.app/Contents/MacOS/Google Drive( |$)"
  "tailscale|󱗼|io.tailscale.ipn.macsys|io.tailscale.ipn.macsys|Tailscale.app/Contents/MacOS/Tailscale( |$)"
  "cisco|󰖂|com.cisco.secureclient.gui|com.cisco.secureclient.vpn.notification|Cisco Secure Client - AnyConnect VPN Service( |$)"
  "handy|󰍬|com.pais.handy|com.pais.handy|Handy.app/Contents/MacOS/handy( |$)"
  "karabiner|󰌌|org.pqrs.Karabiner-Elements.Settings|org.pqrs.Karabiner-Console-User-Server|Karabiner-Core-Service"
)
for entry in "${TRAY[@]}"; do
  IFS='|' read -r name glyph app owner pattern <<< "$entry"
  sketchybar --add item "tray.$name" right \
    --set "tray.$name" \
      label.drawing=off \
      icon="$glyph" \
      icon.color="$MUTED" \
      padding_left=2 \
      padding_right=2 \
      update_freq=30 \
      click_script="$MENUBAR press-extra $owner || open -b $app" \
      script="$PLUGIN_DIR/tray.sh '$pattern'" \
    --subscribe "tray.$name" system_woke
done

sketchybar --update
